# 호스트별 빌드 경로. 이 파일을 .env 로 복사해 채운다 — .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# 한 줄에 KEY=VALUE 하나. 따옴표와 공백 없이 쓴다.
# make-for-imx8.sh / setup-deps.sh / update_bin.sh 가 env.sh 를 통해 함께 읽는다.

# Yocto SDK 설치 위치. ${SDK_LOC}/environment-setup-${SDK_NAME} 이 있어야 한다.
SDK_LOC=
SDK_NAME=cortexa53-crypto-poky-linux

# setup-deps.sh 전용 — hantro 바이너리를 가져올 Yocto recipe-sysroot.
# 보통 <yocto루트>/tmp/work/<target>/imx-vpuwrap/<ver>/recipe-sysroot 다.
# 명령 인자로 주면 그쪽이 우선한다: ./setup-deps.sh <경로>
HANTRO_SYSROOT=

# update_bin.sh 전용 — pim-package 저장소 위치. 비우면 형제 디렉터리
# ../pim-package-jhw 를 쓴다.
PIM_PACKAGE_DIR=
